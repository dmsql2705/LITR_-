# ============================================
# LiTR 백엔드 환경 변수
# ============================================

# Google AI (필수 — Gemini 2.5 Flash)
GOOGLE_AI_API_KEY=your-google-ai-api-key-here

# JWT 인증 (필수)
JWT_SECRET_KEY=your-super-secret-jwt-key-change-this-in-production

# 데이터베이스 (필수 - Supabase PostgreSQL)
# Supabase 대시보드 → Settings → Database → Connection string → URI
DATABASE_URL=postgresql://postgres:YOUR_PASSWORD@db.YOUR_PROJECT.supabase.co:5432/postgres

# Supabase Storage (선택 — 프로필 사진 업로드용)
# Supabase 대시보드 → Settings → API → URL / service_role key
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_SERVICE_KEY=your-supabase-service-role-key

# OAuth Redirect Base URL (배포 환경에 맞게 설정)
BASE_URL=https://litr-production.up.railway.app

# CORS 허용 오리진 (쉼표로 구분, 프로덕션에서 반드시 설정)
ALLOWED_ORIGINS=http://localhost:3000,http://localhost:8000,https://litr-production.up.railway.app

# ============================================
# 소셜 로그인 (선택)
# ============================================

# 디스코드 OAuth
DISCORD_CLIENT_ID=your-discord-client-id
DISCORD_CLIENT_SECRET=your-discord-client-secret
DISCORD_REDIRECT_URI=http://localhost:8000/api/auth/discord/callback

# 구글 OAuth
GOOGLE_CLIENT_ID=your-google-client-id
GOOGLE_CLIENT_SECRET=your-google-client-secret
GOOGLE_REDIRECT_URI=http://localhost:8000/api/auth/google/callback

# 애플 Sign in with Apple
APPLE_CLIENT_ID=your-apple-services-id
APPLE_TEAM_ID=your-apple-team-id
APPLE_KEY_ID=your-apple-key-id
APPLE_PRIVATE_KEY=-----BEGIN PRIVATE KEY-----\nYour Apple Private Key Here\n-----END PRIVATE KEY-----
APPLE_REDIRECT_URI=http://localhost:8000/api/auth/apple/callback

# ============================================
# Agora 음성 채팅 (선택)
# ============================================
AGORA_APP_ID=your-agora-app-id
AGORA_APP_CERTIFICATE=your-agora-certificate

# ============================================
# 이미지 생성 (선택)
# ============================================
# OpenAI API (DALL-E 3)
OPENAI_API_KEY=your-openai-api-key

# ============================================
# 프론트엔드 URL (OAuth 리다이렉트용)
# ============================================
FRONTEND_URL=http://localhost:3000

# ============================================
# Redis (선택 — 없으면 메모리 폴백)
# ============================================
# REDIS_URL=redis://localhost:6379/0

# ============================================
# 데이터베이스 커넥션 풀 (선택 — 기본값 사용 가능)
# ============================================
# DB_POOL_SIZE=5
# DB_MAX_OVERFLOW=10
# DB_POOL_TIMEOUT=30
# DB_POOL_RECYCLE=1800

# ============================================
# 로깅 (선택)
# ============================================
# LOG_LEVEL=INFO
