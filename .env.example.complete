# ============================================
# LiTR 백엔드 환경 변수 - 완전한 예시
# ============================================

# ============================================
# Google AI API (필수 — Gemini 2.5 Flash)
# ============================================
GOOGLE_AI_API_KEY=AIzaSy-여기에-구글-AI-API-키-입력

# ============================================
# JWT 인증 (필수)
# ============================================
# 직접 생성! (https://randomkeygen.com/ 에서 복사)
JWT_SECRET_KEY=xK9mP2nR5tW8yU4iO1aS6dF3gH7jL0qV

# ============================================
# 데이터베이스 (선택, 기본값: SQLite)
# ============================================
DATABASE_URL=sqlite:///./litrpg.db

# ============================================
# OpenAI API - 이미지 생성 (선택)
# ============================================
# OpenAI Platform에서 발급 (https://platform.openai.com/api-keys)
OPENAI_API_KEY=sk-proj-여기에-오픈AI-키-입력

# ============================================
# Agora RTC - 음성 채팅 (선택)
# ============================================
# Agora Console에서 발급 (https://console.agora.io/)
AGORA_APP_ID=12345678901234567890123456789012
AGORA_APP_CERTIFICATE=abcdef1234567890abcdef1234567890

# ============================================
# 소셜 로그인 (선택)
# ============================================

# Discord OAuth (https://discord.com/developers/applications)
DISCORD_CLIENT_ID=1234567890123456789
DISCORD_CLIENT_SECRET=abcdefghijklmnopqrstuvwxyz123456
DISCORD_REDIRECT_URI=http://localhost:8000/api/auth/discord/callback

# Google OAuth (https://console.cloud.google.com/)
GOOGLE_CLIENT_ID=123456789012-abcdefghijklmnopqrstuvwxyz.apps.googleusercontent.com
GOOGLE_CLIENT_SECRET=GOCSPX-abcdefghijklmnopqrstuvwxyz
GOOGLE_REDIRECT_URI=http://localhost:8000/api/auth/google/callback

# Apple Sign in (Apple Developer 계정 필요 - 선택사항)
# 나중에 설정하거나 주석 처리해도 됩니다!
# APPLE_CLIENT_ID=com.yourcompany.litr
# APPLE_TEAM_ID=TEAM123456
# APPLE_KEY_ID=KEY123456
# APPLE_PRIVATE_KEY=-----BEGIN PRIVATE KEY-----\nYour Key\n-----END PRIVATE KEY-----
# APPLE_REDIRECT_URI=http://localhost:8000/api/auth/apple/callback

# ============================================
# Supabase Storage (프로필 사진 업로드용) - 필수
# ============================================
# Supabase 대시보드 → Settings → API에서 확인
SUPABASE_URL=https://your-project-id.supabase.co
SUPABASE_SERVICE_KEY=eyJhbGci... (service_role 키)
